# ========== 运行日志 ==========
[Writable]
LogLevel = 'INFO'
LogPath = 'iotserver/logs/iotserver-core.log'

# ========== 服务端口 ==========
[Service]
Host = '0.0.0.0'
ServerBindAddr = ''
Port = 58081
Timeout = 45000

[WebServer]
Host = '0.0.0.0'
Port = 3000
Timeout = 120

[RpcServer]
Address = '0.0.0.0:57081'
UseTLS = false
CertFile = ''
KeyFile = ''

# ========== 前端 ==========
[WebUI]
BuildPath = './cmd/iotserver-ui/build'

# ========== 数据库 ==========
[Databases]
[Databases.Metadata]
Type = 'sqlite'
DataSource = 'iotserver/db-data/core-data/core.db?_timeout=5000'
# Type = 'mysql'
# Dsn = 'root:123456@tcp(127.0.0.1:3306)/iotserver?charset=utf8mb4&parseTime=True&loc=Local'

[Databases.Data]
# duckdb=单文件列存；iotp=外部时序库（填写下方 BaseURL/Token/Name/Timeout）
Type = 'duckdb'
DataSource = 'iotserver/db-data/duckdb/core-data.duckdb'
# iotp 连接参数（Type='iotp' 时使用；只填 BaseURL 也会启用元数据同步/实时值读取）
# BaseURL = 'http://host:8080'
# Token = ''
# Name = 'iotserver'
# Timeout = 10000  # 毫秒

# ========== 消息与外部服务 ==========
[MessageQueue]
Protocol = 'tcp'
Host = 'mqtt-broker'
Port = 58090
PublishTopicPrefix = 'eventbus/in'

[Clients]
[Clients.Ekuiper]
Protocol = 'http'
Host = 'ekuiper'
Port = 9081

# ========== iotp 多节点采集（可选） ==========
# iotp 集群每个节点有独立 MQTT broker；启用后平台逐节点订阅 ingest/<库名>/json，
# 转成 MessageBus 报文写入上面的 MessageQueue（eventbus/in），
# 规则引擎即可在一张流里消费全集群数据。
# [Integrations.IotpCollect]
# 由 Databases.Data 的 BaseURL 非空自动启用，无需单独开关。
# 自动从受管软网关（source=ioserver）的采集引擎发现 MQTT 目标：
# 启动时发现一次，之后按 ResyncIntervalSec 周期刷新，网关增删改时也会立即刷新。
# 额外静态节点，与自动发现结果按 broker 地址去重（静态节点优先）。
# Nodes = [
#   'n01=tcp://10.0.0.11:1883',
#   'n02=tcp://10.0.0.12:1883',
# ]
# 订阅主题由 Databases.Data.Name 推导，库名缺省为 iotserver。
# 消息类型固定为 PROPERTY_REPORT。
# 租户按「设备自身 → 采集网关」自动解析，不再使用全局兜底租户。
# 未匹配到平台设备时按原始数字 ID 转发（无租户）。
# Username = ''
# Password = ''
# ResyncIntervalSec = 60
