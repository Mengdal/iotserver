# ========== 运行日志 ==========
[Writable]
LogLevel = 'INFO'
LogPath = 'iotserver/logs/iotserver-core.log'

# ========== 服务端口 ==========
[Service]
Host = '0.0.0.0'
ServerBindAddr = ''
Port = 58081
Timeout = 45000

[WebServer]
Host = '0.0.0.0'
Port = 3000
Timeout = 120

[RpcServer]
Address = '0.0.0.0:57081'
UseTLS = false
CertFile = ''
KeyFile = ''

# ========== 前端 ==========
[WebUI]
BuildPath = './cmd/iotserver-ui/build'

# ========== 数据库 ==========
[Databases]
[Databases.Metadata]
Type = 'sqlite'
DataSource = 'iotserver/db-data/core-data/core.db?_timeout=5000'
# Type = 'mysql'
# Dsn = 'root:123456@tcp(127.0.0.1:3306)/iotserver?charset=utf8mb4&parseTime=True&loc=Local'

[Databases.Data]
# duckdb=单文件列存；iotp=外部时序库（填写下方 BaseURL/Token/Name/Timeout）
Type = 'duckdb'
DataSource = 'iotserver/db-data/duckdb/core-data.duckdb'
# iotp 连接参数（Type='iotp' 时使用；只填 BaseURL 也会启用元数据同步/实时值读取）
# BaseURL = 'http://host:8080'
# Token = ''
# Name = 'iotserver'
# Timeout = 10000  # 毫秒

# ========== 消息与外部服务 ==========
[MessageQueue]
Protocol = 'tcp'
Host = 'mqtt-broker'
Port = 58090
PublishTopicPrefix = 'eventbus/in'

[Clients]
[Clients.Ekuiper]
Protocol = 'http'
Host = 'ekuiper'
Port = 9081
