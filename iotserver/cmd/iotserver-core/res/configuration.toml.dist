[Writable]
LogLevel = 'INFO'
LogPath = 'iotserver/logs/iotserver-core.log'

[Service]
Host = '0.0.0.0'
ServerBindAddr = '' # Leave blank so default to Host value unless different value is needed.
Port = 58081
Protocol = 'http'
Timeout = 45000

[RpcServer]
Address = '0.0.0.0:57081'
UseTLS = false
CertFile = ''
KeyFile = ''

[Clients]
[Clients.Ekuiper]
Protocol = 'http'
Host = 'ekuiper'
Port = 9081

[WebServer]
Host = '0.0.0.0'
Port = 3000
Timeout = 120

[Databases]
[Databases.Metadata]
[Databases.Metadata.Primary]
Type = 'sqlite'
DataSource = 'iotserver/db-data/core-data/core.db?_timeout=5000'
#Type = 'mysql'
#Dsn = 'root:123456@tcp(127.0.0.1:3306)/iotserver?charset=utf8mb4&parseTime=True&loc=Local'


[Databases.Data]
[Databases.Data.Primary]
Type = 'duckdb'
DataSource = 'iotserver/db-data/duckdb/core-data.duckdb'

[MessageQueue]
Protocol = 'tcp'
Host = 'mqtt-broker'
Port = 58090
Type = 'mqtt'
PublishTopicPrefix = 'eventbus/in'

# 画布看板（布局 + 文本组件）
# 看板登记文件：看板名称/图标/首页标记，以及每个组件的位置、类型与文本
[Viz]
BoardsFile = '.viz-boards.json'

# 多租户隔离（ROBX：一个实例服务多个租户，按 tenant_id 行级隔离）
# Enforce=false（迁移期）：未带租户上下文的调用不过滤，仅打告警日志；
# Enforce=true（上线）：租户表查询缺少租户上下文时返回空集，写入报错。
[Tenant]
Enforce = false
