# 本地 Shaper 接入配置（复制成 .env.shaper 使用；.env.shaper 已在 .gitignore 里，不会入库）
#
# 这个文件有两处会被读取：
#   1) scripts/start-with-shaper.sh —— 启动前 source 进来（环境变量优先级最高）
#   2) iotserver-core 自己 —— Shaper.LocalEnvFile 指向它，环境变量/toml 都取不到时的兜底
#      （所以别人用 make run / go run 直接启动，也能拿到下面的配置）
# 启动：./scripts/start-with-shaper.sh   或   make start-shaper
#
# API Key 在 Shaper 的 Admin → API Keys 创建（权限勾 jwt），或用 API：
#   curl -X POST http://127.0.0.1:5454/api/keys -H "Authorization: Bearer <管理端JWT>" \
#        -H 'Content-Type: application/json' -d '{"name":"iotserver-embed","permissions":["jwt"]}'
IOTSERVER_SHAPER_APIKEY=
# 要嵌入的看板 ID（在 Shaper 里建好一块看板后拿到，URL 形如 /dashboards/<id>）
IOTSERVER_SHAPER_DASHBOARDID=
# 可选：覆盖实例地址（默认取 configuration.toml 的 Shaper.BaseUrl）
#IOTSERVER_SHAPER_BASEURL=http://127.0.0.1:5454
