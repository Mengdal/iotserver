{
  "id": "builtin-ops",
  "name": "System Monitoring",
  "icon": "area-chart",
  "scope": "platform",
  "canvas": {
    "cols": 12,
    "rowHeight": 40,
    "widgets": [
      {
        "id": "ops-system",
        "title": "系统资源",
        "showTitle": true,
        "type": "stats",
        "layout": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 5
        },
        "config": {
          "tiles": [
            {
              "label": "CPU使用率",
              "metric": "system.cpu.usage",
              "icon": "bolt",
              "tone": "blue"
            },
            {
              "label": "系统负载率",
              "metric": "system.cpu.load",
              "icon": "chart",
              "tone": "cyan",
              "note": "1 分钟平均负载 ÷ 核数"
            },
            {
              "label": "内存占用",
              "metric": "system.memory.used",
              "icon": "db",
              "tone": "purple",
              "tags": [
                {
                  "label": "总量",
                  "metric": "system.memory.total"
                }
              ]
            },
            {
              "label": "磁盘占用",
              "metric": "system.disk.used",
              "icon": "appstore",
              "tone": "green",
              "tags": [
                {
                  "label": "总量",
                  "metric": "system.disk.total"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "ops-cpu-trend",
        "title": "CPU使用率趋势",
        "showTitle": true,
        "type": "line",
        "layout": {
          "x": 0,
          "y": 5,
          "w": 6,
          "h": 8
        },
        "config": {
          "series": [],
          "metrics": [
            "system.cpu.trend"
          ],
          "timeRange": "24h",
          "aggInterval": 300,
          "aggMethod": "avg",
          "showLegend": false,
          "smooth": true,
          "fill": true,
          "stacked": false
        }
      },
      {
        "id": "ops-memory-trend",
        "title": "内存使用率趋势",
        "showTitle": true,
        "type": "line",
        "layout": {
          "x": 6,
          "y": 5,
          "w": 6,
          "h": 8
        },
        "config": {
          "series": [],
          "metrics": [
            "system.memory.trend"
          ],
          "timeRange": "24h",
          "aggInterval": 300,
          "aggMethod": "avg",
          "showLegend": false,
          "smooth": true,
          "fill": true,
          "stacked": false
        }
      }
    ]
  }
}
