  "alarmRules": [
    {
      "name": "料筒超温",
      "propertyCode": "barrel_temp",
      "operator": ">",
      "value": "260",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "料筒温度超过 260℃",
      "nameEn": "Barrel overtemperature",
      "descriptionEn": "Barrel temperature above 260°C"
    },
    {
      "name": "注射压力低",
      "propertyCode": "injection_pressure",
      "operator": "<",
      "value": "40",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 600,
      "description": "注射压力低于 40 MPa",
      "nameEn": "Low injection pressure",
      "descriptionEn": "Injection pressure below 40 MPa"
    },
    {
      "name": "周期超限",
      "propertyCode": "cycle_time",
      "operator": ">",
      "value": "120",
      "alertLevel": 3,
      "alertType": 1,
      "silenceTime": 900,
      "description": "成型周期超过 120 秒",
      "nameEn": "Cycle time exceeded",
      "descriptionEn": "Molding cycle time above 120 seconds"
    },
    {
      "name": "模具温度高",
      "propertyCode": "mold_temp",
      "operator": ">",
      "value": "120",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 600,
      "description": "模具温度超过 120℃",
      "nameEn": "High mold temperature",
      "descriptionEn": "Mold temperature above 120°C"
    },
    {
      "name": "不良品数偏高",
      "propertyCode": "reject_count",
      "operator": ">",
      "value": "20",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 1800,
      "description": "累计不良品模数超过 20",
      "nameEn": "High rejected product count",
      "descriptionEn": "Cumulative rejected molds above 20"
    }
