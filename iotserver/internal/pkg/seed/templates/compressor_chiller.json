  "alarmRules": [
    {
      "name": "排气压力高",
      "propertyCode": "discharge_pressure",
      "operator": ">",
      "value": "2.8",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "排气压力超过 2.8 MPa"
    },
    {
      "name": "吸气压力低",
      "propertyCode": "suction_pressure",
      "operator": "<",
      "value": "0.2",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "吸气压力低于 0.2 MPa"
    },
    {
      "name": "油温过高",
      "propertyCode": "oil_temp",
      "operator": ">",
      "value": "85",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "润滑油温度超过 85℃"
    },
    {
      "name": "运行电流超限",
      "propertyCode": "run_current",
      "operator": ">",
      "value": "320",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 600,
      "description": "运行电流超过 320 A"
    },
    {
      "name": "水温差偏大",
      "propertyCode": "water_temp_diff",
      "operator": ">",
      "value": "8",
      "alertLevel": 3,
      "alertType": 1,
      "silenceTime": 900,
      "description": "进出水温差超过 8℃，疑似水流不足"
    }
