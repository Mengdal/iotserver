  "alarmRules": [
    {
      "name": "冷冻库高温",
      "propertyCode": "freezer_temp",
      "operator": ">",
      "value": "-15",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "冷冻库温度高于 -15℃",
      "descriptionEn": "Freezer temperature above -15°C"
    },
    {
      "name": "冷冻库低温",
      "propertyCode": "freezer_temp",
      "operator": "<",
      "value": "-25",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "冷冻库温度低于 -25℃",
      "descriptionEn": "Freezer temperature below -25°C"
    },
    {
      "name": "开门超时",
      "propertyCode": "door_open_duration",
      "operator": ">",
      "value": "300",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "冷冻库门开启超过 300 秒",
      "descriptionEn": "Freezer door open over 300 seconds"
    },
    {
      "name": "传感器故障",
      "propertyCode": "sensor_status",
      "operator": "=",
      "value": "0",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "温度传感器离线或故障",
      "descriptionEn": "Temperature sensor offline"
    },
    {
      "name": "断电报警",
      "propertyCode": "power_status",
      "operator": "=",
      "value": "0",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "市电断电，网关转备用电池",
      "descriptionEn": "Mains power lost, gateway on battery"
    },
    {
      "name": "网关离线",
      "propertyCode": "gateway_online",
      "operator": "=",
      "value": "0",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "4G 网关离线",
      "descriptionEn": "4G gateway offline"
    }
  ],
  "dashboard": {
    "name": "冷冻库监控看板",
    "nameEn": "Freezer Room Dashboard",
    "widgets": [
      {
        "title": "冷冻库温度趋势",
        "type": "line",
        "propertyCode": "freezer_temp",
