  "alarmRules": [
    {
      "name": "液位低",
      "propertyCode": "liquid_level",
      "operator": "<",
      "value": "20",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "料缸液位低于 20%"
    },
    {
      "name": "计量偏差超限",
      "propertyCode": "filling_accuracy",
      "operator": ">",
      "value": "2",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 600,
      "description": "灌装计量偏差超过 2%"
    },
    {
      "name": "不合格数偏高",
      "propertyCode": "reject_count",
      "operator": ">",
      "value": "50",
      "alertLevel": 3,
      "alertType": 1,
      "silenceTime": 1800,
      "description": "累计不合格瓶数超过 50"
    },
    {
      "name": "节拍超限",
      "propertyCode": "cycle_time",
      "operator": ">",
      "value": "30",
      "alertLevel": 3,
      "alertType": 1,
      "silenceTime": 900,
      "description": "灌装节拍超过 30 秒"
    },
    {
      "name": "缺料",
      "propertyCode": "material_status",
      "operator": "=",
      "value": "1",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "料缸缺料"
    }
  ],
