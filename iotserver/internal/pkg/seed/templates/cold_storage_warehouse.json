  "alarmRules": [
    {
      "name": "库温高报警",
      "propertyCode": "room_temp",
      "operator": ">",
      "value": "8",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "库温超过 8℃",
      "descriptionEn": "Cold room temperature above 8°C"
    },
    {
      "name": "库温低报警",
      "propertyCode": "room_temp",
      "operator": "<",
      "value": "-5",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "库温低于 -5℃",
      "descriptionEn": "Chilled room temperature below -5°C"
    },
    {
      "name": "湿度过高",
      "propertyCode": "room_humidity",
      "operator": ">",
      "value": "85",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "库内湿度超过 85%RH",
      "descriptionEn": "Cold room humidity above 85%RH"
    },
    {
      "name": "湿度过低",
      "propertyCode": "room_humidity",
      "operator": "<",
      "value": "40",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "库内湿度低于 40%RH",
      "descriptionEn": "Cold room humidity below 40%RH"
    },
    {
      "name": "开门超时",
      "propertyCode": "door_open_duration",
      "operator": ">",
      "value": "300",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "库门开启超过 300 秒",
      "descriptionEn": "Cold room door open over 300 seconds"
    },
    {
      "name": "传感器故障",
      "propertyCode": "sensor_status",
      "operator": "=",
      "value": "0",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "温湿度传感器离线或故障",
      "descriptionEn": "Temperature/humidity sensor offline"
    },
    {
      "name": "断电报警",
      "propertyCode": "power_status",
      "operator": "=",
      "value": "0",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "市电断电，网关转备用电池",
      "descriptionEn": "Mains power lost, gateway on battery"
    },
    {
      "name": "网关离线",
      "propertyCode": "gateway_online",
      "operator": "=",
      "value": "0",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "4G 网关离线",
      "descriptionEn": "4G gateway offline"
    }
  ],
