  "alarmRules": [
    {
      "name": "主轴过载",
      "propertyCode": "spindle_load",
      "operator": ">",
      "value": "85",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "主轴负载高于 85%",
      "nameEn": "Spindle overload",
      "descriptionEn": "Spindle load above 85%"
    },
    {
      "name": "刀具磨损报警",
      "propertyCode": "tool_wear",
      "operator": ">",
      "value": "80",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "刀具磨损高于 80%",
      "nameEn": "Tool wear warning",
      "descriptionEn": "Tool wear above 80%"
    },
    {
      "name": "冷却液温度高",
      "propertyCode": "coolant_temp",
      "operator": ">",
      "value": "45",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "冷却液温度高于 45℃",
      "nameEn": "High coolant temperature",
      "descriptionEn": "Coolant temperature above 45°C"
