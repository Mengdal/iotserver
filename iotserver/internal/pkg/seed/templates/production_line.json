  "alarmRules": [
    {
      "name": "停机时长超限",
      "propertyCode": "stop_duration",
      "operator": ">",
      "value": "30",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 600,
      "description": "当日累计停机超过 30 分钟",
      "nameEn": "Downtime duration exceeded",
      "descriptionEn": "Cumulative downtime today above 30 minutes"
    },
    {
      "name": "节拍超限",
      "propertyCode": "cycle_time",
      "operator": ">",
      "value": "60",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 600,
      "description": "产线节拍超过 60 秒",
      "nameEn": "Takt time exceeded",
      "descriptionEn": "Production line takt time above 60 seconds"
    },
    {
      "name": "不良品数超限",
      "propertyCode": "reject_count",
      "operator": ">",
      "value": "100",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 1800,
      "description": "累计不良品超过 100 件",
      "nameEn": "Rejected product count exceeded",
      "descriptionEn": "Cumulative rejected products above 100"
    },
    {
      "name": "稼动率偏低",
      "propertyCode": "utilization_rate",
      "operator": "<",
      "value": "60",
      "alertLevel": 3,
      "alertType": 1,
      "silenceTime": 1800,
      "description": "稼动率低于 60%",
      "nameEn": "Low availability rate",
      "descriptionEn": "Availability below 60%"
    },
    {
      "name": "工位故障",
      "propertyCode": "station_status",
      "operator": "=",
      "value": "3",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "关键工位故障停机",
      "nameEn": "Station fault",
      "descriptionEn": "Critical station fault causing downtime"
    }
  ],
