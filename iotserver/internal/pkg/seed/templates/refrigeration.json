            "identifier": "threshold",
            "dataType": "FLOAT",
            "required": false,
            "dataSpecs": {
              "max": "50",
              "min": "-40",
              "step": "0.1",
              "unit": "℃",
              "unitName": "摄氏度"
            },
            "dataSpecsList": null
          }
        ]
      },
      {
        "eventName": "开门超时",
        "eventType": "ALERT",
        "identifier": "door_timeout",
