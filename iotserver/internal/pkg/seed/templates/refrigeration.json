        "rwFlag": "RW",
        "dataSpecs": {
          "max": "50",
          "min": "-40",
          "step": "0.1",
          "unit": "℃",
          "unitName": "摄氏度"
        },
        "dataSpecsList": null
      },
      {
        "name": "温度偏差",
        "identifier": "temp_deviation",
        "dataType": "FLOAT",
        "description": "库温与设定温度的偏差",
        "required": false,
        "rwFlag": "R",
        "dataSpecs": {
          "max": "20",
          "min": "0",
          "step": "0.1",
          "unit": "℃",
          "unitName": "摄氏度"
        },
        "dataSpecsList": null
      },
      {
        "name": "压缩机状态",
        "identifier": "compressor_status",
        "dataType": "BOOL",
        "description": "压缩机运行状态",
        "required": false,
        "rwFlag": "R",
        "dataSpecs": null,
        "dataSpecsList": [
          {
            "name": "停止",
            "value": 0
          },
          {
            "name": "运行",
            "value": 1
          }
        ]
      },
      {
        "name": "化霜状态",
        "identifier": "defrost_status",
        "dataType": "ENUM",
        "description": "蒸发器化霜状态",
        "required": false,
        "rwFlag": "R",
        "dataSpecs": null,
        "dataSpecsList": [
          {
            "name": "停止",
            "value": 0
          },
          {
            "name": "化霜中",
            "value": 1
          },
          {
            "name": "滴水延时",
            "value": 2
          }
        ]
      },
      {
        "name": "门开关",
        "identifier": "door_status",
        "dataType": "BOOL",
        "description": "库门开关状态",
        "required": false,
        "rwFlag": "R",
        "dataSpecs": null,
        "dataSpecsList": [
          {
            "name": "关闭",
            "value": 0
          },
          {
            "name": "打开",
            "value": 1
          }
