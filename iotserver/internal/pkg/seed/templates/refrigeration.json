        "rwFlag": "R",
        "dataSpecs": null,
        "dataSpecsList": [
          {
            "name": "停止",
            "value": 0
          },
          {
            "name": "运行",
            "value": 1
          }
        ]
      },
      {
        "name": "化霜周期",
        "identifier": "defrost_cycle",
        "dataType": "INT",
        "description": "两次化霜的间隔周期",
        "required": false,
        "rwFlag": "R",
        "dataSpecs": {
          "max": "1440",
          "min": "0",
          "step": "1",
          "unit": "min",
          "unitName": "分钟"
        },
        "dataSpecsList": null
      },
      {
        "name": "冷凝压力",
        "identifier": "condensing_pressure",
        "dataType": "FLOAT",
        "description": "冷凝器侧制冷剂压力",
        "required": false,
        "rwFlag": "R",
        "dataSpecs": {
          "max": "4.0",
          "min": "0",
          "step": "0.01",
          "unit": "MPa",
          "unitName": "兆帕"
        },
        "dataSpecsList": null
      },
      {
        "name": "蒸发温度",
        "identifier": "evaporator_temp",
        "dataType": "FLOAT",
        "description": "蒸发器出口温度",
