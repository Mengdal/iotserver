        "required": false,
        "rwFlag": "R",
        "dataSpecs": {
          "max": "600",
          "min": "0",
          "step": "1",
          "unit": "s",
          "unitName": "秒"
        },
        "dataSpecsList": null
      },
      {
        "name": "能耗",
        "identifier": "energy_consumption",
        "dataType": "FLOAT",
        "description": "机组累计能耗",
        "required": false,
        "rwFlag": "R",
        "dataSpecs": {
          "max": "9999.9",
          "min": "0",
          "step": "0.1",
          "unit": "kW·h",
          "unitName": "千瓦时"
