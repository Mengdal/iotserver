{
  "key": "refrigeration",
  "name": "冷库制冷机组",
  "industry": "冷链仓储",
  "version": 1,
  "icon": "database",
  "description": "冷库库温、化霜、门禁与机组能耗监控",
  "thingModelJson": {
    "properties": [
      {
        "name": "库温",
        "identifier": "store_temp",
        "dataType": "FLOAT",
        "description": "冷库内实时温度",
        "required": false,
        "rwFlag": "R",
        "dataSpecs": {
          "max": "50",
          "min": "-40",
          "step": "0.1",
          "unit": "℃",
          "unitName": "摄氏度"
        },
        "dataSpecsList": null
      },
      {
        "name": "回温",
        "identifier": "return_temp",
        "dataType": "FLOAT",
        "description": "蒸发器回气温度",
        "required": false,
        "rwFlag": "R",
        "dataSpecs": {
          "max": "50",
          "min": "-40",
          "step": "0.1",
          "unit": "℃",
          "unitName": "摄氏度"
        },
        "dataSpecsList": null
      },
      {
        "name": "设定温度",
        "identifier": "set_temp",
        "dataType": "FLOAT",
        "description": "冷库目标温度，支持远程下发",
