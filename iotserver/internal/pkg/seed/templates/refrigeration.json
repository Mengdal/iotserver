  "alarmRules": [
    {
      "name": "库温高报警",
      "propertyCode": "store_temp",
      "operator": ">",
      "value": "8",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "库温超过 8℃",
      "nameEn": "High cold storage temperature alarm",
      "descriptionEn": "Cold storage temperature above 8°C"
    },
    {
      "name": "库温低报警",
      "propertyCode": "store_temp",
      "operator": "<",
      "value": "-25",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "库温低于 -25℃",
      "nameEn": "Low cold storage temperature alarm",
      "descriptionEn": "Cold storage temperature below -25°C"
    },
    {
      "name": "开门超时",
      "propertyCode": "door_open_duration",
      "operator": ">",
      "value": "300",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 600,
      "description": "库门开启超过 300 秒",
      "nameEn": "Door open timeout",
      "descriptionEn": "Cold room door open for more than 300 seconds"
    },
    {
      "name": "压缩机停机",
      "propertyCode": "compressor_status",
      "operator": "=",
      "value": "0",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 600,
      "description": "压缩机非计划停机",
      "nameEn": "Compressor stopped",
      "descriptionEn": "Unplanned compressor downtime"
    },
    {
      "name": "能耗异常",
      "propertyCode": "energy_consumption",
      "operator": ">",
      "value": "500",
      "alertLevel": 3,
      "alertType": 1,
      "silenceTime": 1800,
      "description": "单日能耗超过 500 kW·h",
      "nameEn": "Energy consumption abnormality",
      "descriptionEn": "Daily energy consumption above 500 kWh"
    }
