  "alarmRules": [
    {
      "name": "出水温度高报警",
      "propertyCode": "outlet_water_temp",
      "operator": ">",
      "value": "37",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "出水温度高于 37℃",
      "nameEn": "High outlet water temperature",
      "descriptionEn": "Outlet water temperature above 37°C"
    },
    {
      "name": "逼近度偏大",
      "propertyCode": "approach_temp",
      "operator": ">",
      "value": "5",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "逼近度高于 5℃，可能通风不足",
      "nameEn": "Large approach temperature",
      "descriptionEn": "Approach temperature above 5°C, possible insufficient air flow"
    },
    {
      "name": "振动超标",
      "propertyCode": "vibration",
      "operator": ">",
      "value": "7.1",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "振动值高于 7.1 mm/s",
      "nameEn": "High vibration",
      "descriptionEn": "Vibration above 7.1 mm/s"
    }
  ],
  "dashboard": {
    "name": "冷却塔看板",
    "widgets": [
      {
        "title": "出水温度趋势",
        "type": "line",
