        "aggMethod": "avg",
        "titleEn": "Outlet water temperature trend"
      },
      {
        "title": "当前出水温度",
        "type": "kpi",
        "propertyCode": "outlet_water_temp",
        "titleEn": "Current outlet water temperature"
      },
      {
        "title": "风机转速",
        "type": "kpi",
        "propertyCode": "fan_speed",
        "titleEn": "Fan speed"
      }
    ],
    "nameEn": "Cooling Tower Dashboard"
  },
  "metrics": {
    "running": "fan_status",
    "output": null,
    "good": null,
    "reject": null,
    "cycleTime": null
  },
  "nameEn": "Cooling Tower",
