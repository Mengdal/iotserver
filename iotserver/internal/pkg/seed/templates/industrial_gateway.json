  "alarmRules": [
    {
      "name": "CPU使用率过高",
      "propertyCode": "CPU_USAGE",
      "operator": ">",
      "value": "85",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 300,
      "description": "网关 CPU 使用率超过 85%",
      "nameEn": "High CPU usage"
    },
    {
      "name": "信号质量弱",
      "propertyCode": "CSQ",
      "operator": "<",
      "value": "8",
      "alertLevel": 3,
      "alertType": 1,
      "silenceTime": 600,
      "description": "蜂窝信号质量低于 8",
      "nameEn": "Weak signal quality"
    },
    {
      "name": "IO点数异常",
      "propertyCode": "IOPoints",
      "operator": "=",
      "value": "0",
      "alertLevel": 3,
      "alertType": 1,
      "silenceTime": 600,
      "description": "网关下未识别到任何 IO 点",
      "nameEn": "No I/O points"
    }
  ],
