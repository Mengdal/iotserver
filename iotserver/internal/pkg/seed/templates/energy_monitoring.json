  "alarmRules": [
    {
      "name": "A相过压",
      "propertyCode": "voltage_a",
      "operator": ">",
      "value": "250",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "A 相电压超过 250 V"
    },
    {
      "name": "A相欠压",
      "propertyCode": "voltage_a",
      "operator": "<",
      "value": "190",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "A 相电压低于 190 V"
    },
    {
      "name": "A相过流",
      "propertyCode": "current_a",
      "operator": ">",
      "value": "400",
      "alertLevel": 1,
      "alertType": 1,
      "silenceTime": 300,
      "description": "A 相电流超过 400 A"
    },
    {
      "name": "功率因数低",
      "propertyCode": "power_factor",
      "operator": "<",
      "value": "0.9",
      "alertLevel": 3,
      "alertType": 1,
      "silenceTime": 1800,
      "description": "功率因数低于 0.9"
    },
    {
      "name": "需量超限",
      "propertyCode": "demand",
      "operator": ">",
      "value": "800",
      "alertLevel": 2,
      "alertType": 1,
      "silenceTime": 900,
      "description": "需量超过 800 kW"
    }
  ],
