#!/bin/sh
#
# iotserver MQTT broker (Mosquitto) — Buildroot / BusyBox init
#
# 运行用户由安装脚本决定：Buildroot 镜像常把 /dev/* 设成 root:root 0660，
# 非 root 进程打不开 /dev/null（os/exec 启动子进程需要），此时必须用 root。
[ -f /etc/iotserver/iotserver.env ] && . /etc/iotserver/iotserver.env
RUN_USER="${RUN_USER:-iotserver}"

DAEMON=/opt/iotserver/bin/mosquitto
CONF=/etc/iotserver/mosquitto.conf
PIDFILE=/var/run/iotserver-mosquitto.pid
NAME=iotserver-mqtt

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    if is_running; then
        echo "$NAME already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    if [ ! -x "$DAEMON" ]; then
        echo "$NAME: $DAEMON not found" >&2
        return 1
    fi
    mkdir -p /var/lib/iotserver/mosquitto /var/log/iotserver
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -c "$RUN_USER" -x "$DAEMON" -- -c "$CONF"
    sleep 1
    if is_running; then
        echo "$NAME started (pid $(cat "$PIDFILE"))"
    else
        echo "$NAME failed to start, see /var/log/iotserver/mosquitto.log" >&2
        return 1
    fi
}

stop() {
    if ! is_running; then
        echo "$NAME not running"
        rm -f "$PIDFILE"
        return 0
    fi
    pid=$(cat "$PIDFILE")
    kill "$pid" 2>/dev/null
    i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done
    kill -9 "$pid" 2>/dev/null
    rm -f "$PIDFILE"
    echo "$NAME stopped"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start|stop|restart)
        "$1"
        ;;
    status)
        if is_running; then
            echo "$NAME running (pid $(cat "$PIDFILE"))"
        else
            echo "$NAME stopped"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
