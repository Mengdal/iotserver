[Unit]
Description=iotserver eKuiper
Documentation=https://ekuiper.org/
After=network-online.target iotserver-mqtt.service
Wants=network-online.target
Requires=iotserver-mqtt.service

[Service]
Type=simple
User=iotserver
Group=iotserver
WorkingDirectory=/opt/iotserver/ekuiper
Environment=MQTT_SOURCE__DEFAULT__SERVER=tcp://127.0.0.1:58090
# 2.4 默认禁止规则访问私网地址，平台回调地址是 127.0.0.1，必须放开
Environment=KUIPER__BASIC__ENABLEPRIVATENET=true
Environment=KUIPER__BASIC__CONSOLELOG=false
ExecStart=/opt/iotserver/ekuiper/bin/kuiperd
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
