[Unit]
Description=iotserver core
Documentation=https://github.com/LMgateways
After=network-online.target iotserver-mqtt.service iotserver-ekuiper.service
Wants=network-online.target iotserver-mqtt.service iotserver-ekuiper.service

[Service]
Type=simple
User=iotserver
Group=iotserver
WorkingDirectory=/opt/iotserver
ExecStart=/opt/iotserver/bin/iotserver-core -c /etc/iotserver/configuration.toml
Restart=always
RestartSec=3
LimitNOFILE=65535
# 串口驱动需要访问 tty 设备时，按实际设备追加：
# SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
